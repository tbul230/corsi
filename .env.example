# Firebase web app config (public — safe in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=corsitask.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=corsitask
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=corsitask.firebasestorage.app

# Server-only secrets (never prefix with NEXT_PUBLIC_)
# Service account JSON from Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=
# Random string, 32+ characters, used to sign session cookies
SESSION_SECRET=
# Google accounts with administrator access (comma separated)
ADMIN_EMAILS=tbuland@collegiateschool.org,teddyb.ceo@gmail.com,edivan@collegiateschool.org
