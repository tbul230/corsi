# Supabase project (Settings → API). Both values are safe to expose to the browser:
# the publishable key can only call the token-checked RPC functions and admin
# reads are gated by Row Level Security + the public.admins table.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
